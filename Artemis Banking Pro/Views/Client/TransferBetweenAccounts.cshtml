@{
    ViewData["Title"] = "Transferencia entre cuentas";
    Layout = "_Layout";
    var cuentas = ViewBag.Cuentas as List<ArtemisBankingPro.Core.Domain.Entities.CuentaAhorro> ?? new();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h2 class="h4 fw-bold text-dark mb-3">Transferencia entre cuentas propias</h2>
                <p class="text-muted mb-4">Mueva fondos de manera inmediata entre sus cuentas de ahorro activas.</p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="TransferBetweenAccounts" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="cuentaOrigenId" class="form-label fw-semibold">Cuenta de origen</label>
                        <select name="cuentaOrigenId" id="cuentaOrigenId" class="form-select rounded-3" required>
                            <option value="">Seleccione cuenta de origen...</option>
                            @foreach (var c in cuentas)
                            {
                                <option value="@c.Id">@c.NumeroCuenta - Balance: RD$@c.Balance.ToString("N2")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="cuentaDestinoId" class="form-label fw-semibold">Cuenta de destino</label>
                        <select name="cuentaDestinoId" id="cuentaDestinoId" class="form-select rounded-3" required>
                            <option value="">Seleccione cuenta de destino...</option>
                            @foreach (var c in cuentas)
                            {
                                <option value="@c.Id">@c.NumeroCuenta - Balance: RD$@c.Balance.ToString("N2")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="monto" class="form-label fw-semibold">Monto a transferir</label>
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input type="number" step="0.01" min="0.01" name="monto" id="monto" class="form-control rounded-end-3" placeholder="0.00" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm">Realizar transferencia</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
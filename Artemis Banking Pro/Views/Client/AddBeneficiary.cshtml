@model ArtemisBankingPro.WebApp.ViewModels.AddBeneficiaryViewModel
@{
    ViewData["Title"] = "Agregar Beneficiario";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white" style="max-width: 550px; width: 100%;">
        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                <i class="bi bi-person-badge fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Nuevo Beneficiario</h3>
            <p class="text-muted">Ingrese los 9 dígitos de la cuenta de ahorro que desea registrar.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger rounded-3 shadow-sm border-0 small fw-semibold"></div>
        }

        <form asp-action="AddBeneficiary" method="post">
            <div class="mb-4">
                <label asp-for="NumeroCuenta" class="form-label fw-bold text-secondary text-uppercase small">Número de Cuenta</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-hash"></i></span>
                    <input asp-for="NumeroCuenta" class="form-control border-start-0 bg-light form-control-lg font-monospace fw-bold" placeholder="Ej. 123456789" maxlength="9" />
                </div>
                <span asp-validation-for="NumeroCuenta" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="Beneficiaries" class="btn btn-light px-4 rounded-pill fw-bold text-secondary border">Cancelar</a>
                <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold shadow-sm">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@{
    ViewData["Title"] = "Avance de Efectivo";
    Layout = "_Layout";
    var tarjetas = ViewBag.Tarjetas as List<ArtemisBankingPro.Core.Domain.Entities.TarjetaCredito> ?? new();
    var cuentas = ViewBag.Cuentas as List<ArtemisBankingPro.Core.Domain.Entities.CuentaAhorro> ?? new();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h2 class="h4 fw-bold text-dark mb-3">Avance de Efectivo</h2>
                <p class="text-muted mb-4">Transfiera fondos desde su tarjeta de crédito activa hacia su cuenta de ahorro.</p>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="CashAdvance" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="tarjetaCreditoId" class="form-label fw-semibold">Tarjeta de crédito origen</label>
                        <select name="tarjetaCreditoId" id="tarjetaCreditoId" class="form-select rounded-3" required>
                            <option value="">Seleccione una tarjeta...</option>
                            @foreach (var t in tarjetas)
                            {
                                <option value="@t.Id">**** **** **** @t.NumeroTarjeta[^4..] (Disponible: RD$@t.CreditoDisponible.ToString("N2"))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="cuentaAhorroId" class="form-label fw-semibold">Cuenta de ahorro destino</label>
                        <select name="cuentaAhorroId" id="cuentaAhorroId" class="form-select rounded-3" required>
                            <option value="">Seleccione una cuenta...</option>
                            @foreach (var c in cuentas)
                            {
                                <option value="@c.Id">@c.NumeroCuenta (Balance: RD$@c.Balance.ToString("N2"))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="monto" class="form-label fw-semibold">Monto del avance de efectivo</label>
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input type="number" step="0.01" min="0.01" name="monto" id="monto" class="form-control rounded-end-3" placeholder="0.00" required />
                        </div>
                        <small class="text-muted">Se aplicará un cargo de interés del 6.25% sobre el monto solicitado que se sumará a la deuda de la tarjeta.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm">Realizar avance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@model ArtemisBankingPro.Core.Domain.Entities.CuentaAhorro

@{
    ViewData["Title"] = "Transacciones de la Cuenta";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Transacciones de la Cuenta</h2>
            <p class="text-muted mb-0">Número de cuenta: <span class="font-monospace fw-bold text-dark">@Model.NumeroCuenta</span></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Volver al Panel</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Tipo Operación</th>
                        <th>Tipo</th>
                        <th>Origen / Destino</th>
                        <th class="text-end">Monto</th>
                        <th class="text-center pe-4">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transacciones != null && Model.Transacciones.Any())
                    {
                        foreach (var tx in Model.Transacciones.OrderByDescending(t => t.Fecha))
                        {
                            <tr>
                                <td class="ps-4">@tx.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold">@tx.TipoOperacion</td>
                                <td>
                                    <span class="badge bg-@(tx.Tipo.ToString() == "Credito" ? "success" : "danger") px-2 py-1">
                                        @tx.Tipo
                                    </span>
                                </td>
                                <td><small class="text-muted">Origen:</small> @tx.Origen <br><small class="text-muted">Destino:</small> @tx.Destino</td>
                                <td class="text-end fw-bold text-@(tx.Tipo.ToString() == "Credito" ? "success" : "danger")">
                                    @(tx.Tipo.ToString() == "Credito" ? "+" : "-")RD$@tx.Monto.ToString("N2")
                                </td>
                                <td class="text-center pe-4">
                                    <span class="badge bg-@(tx.Estado.ToString() == "Aprobada" ? "success" : "secondary")">@tx.Estado</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay transacciones registradas para esta cuenta.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
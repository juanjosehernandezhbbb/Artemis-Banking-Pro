@model ArtemisBankingPro.WebApp.ViewModels.ConfirmTransferViewModel
@{
    ViewData["Title"] = "Confirmar Transferencia";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3 mb-3">
            <i class="bi bi-question-circle fs-1"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Confirmar Transacción</h3>
        <p class="text-muted mb-4">¿Está seguro de que desea realizar esta transacción?</p>

        <div class="bg-light rounded-4 p-4 text-start mb-4 border">
            <div class="mb-3">
                <span class="text-muted small fw-bold text-uppercase d-block">Titular de la Cuenta Beneficiaria</span>
                <h5 class="fw-bold text-dark mb-0">@Model.BeneficiaryName</h5>
            </div>
            <div class="mb-3">
                <span class="text-muted small fw-bold text-uppercase d-block">Número de Cuenta Destino</span>
                <h5 class="font-monospace fw-bold text-primary mb-0">@Model.BeneficiaryAccountNumber</h5>
            </div>
            <div class="mb-3">
                <span class="text-muted small fw-bold text-uppercase d-block">Cuenta de Origen</span>
                <h5 class="font-monospace fw-bold text-secondary mb-0">@Model.SourceAccountNumber</h5>
            </div>
            <div>
                <span class="text-muted small fw-bold text-uppercase d-block">Monto a Transferir</span>
                <h3 class="fw-bold text-success mb-0">RD$ @Model.Amount.ToString("N2")</h3>
            </div>
        </div>

        <form asp-action="ExecuteTransfer" method="post">
            <input type="hidden" asp-for="BeneficiaryId" />
            <input type="hidden" asp-for="SourceAccountId" />
            <input type="hidden" asp-for="Amount" />

            <div class="d-flex justify-content-between gap-3">
                <a asp-action="Index" class="btn btn-light w-50 py-2 rounded-pill fw-bold text-secondary border">Cancelar</a>
                <button type="submit" class="btn btn-success w-50 py-2 rounded-pill fw-bold shadow-sm">Confirmar</button>
            </div>
        </form>
    </div>
</div>
@model ArtemisBankingPro.WebApp.ViewModels.ExpressConfirmationViewModel
@{
    ViewData["Title"] = "Confirmar Transacción";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center" style="max-width: 550px; width: 100%;">
        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
            <i class="bi bi-question-circle fs-1"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Confirmar Transacción</h3>
        <p class="text-muted mb-4">¿Está seguro de que desea realizar esta transacción?</p>

        <div class="bg-light rounded-4 p-4 text-start mb-4">
            <div class="row mb-2">
                <div class="col-6 text-muted small fw-bold">CUENTA ORIGEN:</div>
                <div class="col-6 text-end font-monospace fw-bold">@Model.SourceAccountNumber</div>
            </div>
            <div class="row mb-2">
                <div class="col-6 text-muted small fw-bold">CUENTA DESTINO:</div>
                <div class="col-6 text-end font-monospace fw-bold">@Model.TargetAccountNumber</div>
            </div>
            <div class="row mb-2">
                <div class="col-6 text-muted small fw-bold">BENEFICIARIO:</div>
                <div class="col-6 text-end fw-bold text-dark">@Model.TargetClientName</div>
            </div>
            <hr>
            <div class="row align-items-center">
                <div class="col-6 text-muted small fw-bold">MONTO A ENVIAR:</div>
                <div class="col-6 text-end fs-4 fw-bold text-success">RD$@Model.Amount.ToString("N2")</div>
            </div>
        </div>

        <form asp-action="ConfirmExpressTransaction" method="post">
            <input type="hidden" asp-for="TargetAccountNumber" />
            <input type="hidden" asp-for="Amount" />
            <input type="hidden" asp-for="SourceAccountId" />
            <input type="hidden" asp-for="SourceAccountNumber" />

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light px-4 rounded-pill fw-bold text-secondary border">Cancelar</a>
                <button type="submit" class="btn btn-success px-5 rounded-pill fw-bold shadow-sm">Confirmar</button>
            </div>
        </form>
    </div>
</div>
@model ArtemisBankingPro.Core.Domain.Entities.Prestamo

@{
    ViewData["Title"] = "Tabla de Amortización del Préstamo";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Tabla de Amortización</h2>
            <p class="text-muted mb-0">Préstamo #<span class="fw-bold text-dark">@Model.NumeroPrestamo</span> | Capital: RD$@Model.CapitalAprobado.ToString("N2")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Volver al Panel</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Cuota #</th>
                        <th>Fecha Vencimiento</th>
                        <th class="text-end">Monto Cuota</th>
                        <th class="text-end">Saldo Pendiente</th>
                        <th class="text-center pe-4">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cuotas != null && Model.Cuotas.Any())
                    {
                        int index = 1;
                        foreach (var cuota in Model.Cuotas.OrderBy(c => c.FechaVencimiento))
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@(index++)</td>
                                <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-semibold">RD$@cuota.ValorCuota.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">RD$@cuota.SaldoPendiente.ToString("N2")</td>
                                <td class="text-center pe-4">
                                    @{
                                        string estadoBadge = cuota.EstadoPago.ToString() == "Pagada" ? "success" : cuota.EstadoPago.ToString() == "ParcialmentePagada" ? "warning text-dark" : "secondary";
                                    }
                                    <span class="badge bg-@estadoBadge px-3 py-2 rounded-pill">@cuota.EstadoPago</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No hay cuotas registradas para este préstamo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
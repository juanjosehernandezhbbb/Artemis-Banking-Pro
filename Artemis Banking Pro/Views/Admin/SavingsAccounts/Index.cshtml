@model ArtemisBankingPro.Core.Application.Common.Models.PagedResult<ArtemisBankingPro.Core.Application.SavingsAccounts.GetSavingsAccounts.SavingsAccountListItemDto>

@{
    ViewData["Title"] = "Gestión de Cuentas de Ahorro";
    Layout = "_Layout";
    string currentStatus = ViewBag.CurrentStatus as string ?? "Activas";
    string currentType = ViewBag.CurrentType as string ?? "Todas";
    string currentId = ViewBag.CurrentIdentification as string ?? "";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Gestión de Cuentas de Ahorro</h1>
            <p class="text-muted mb-0">Administración de cuentas principales y secundarias del sistema.</p>
        </div>
        <a asp-action="SelectClient" class="btn btn-primary fw-bold rounded-3 shadow-sm px-4">
            <i class="bi bi-piggy-bank-fill me-2"></i> Asignar cuenta de ahorro
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros y Búsqueda -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-4">
                <label for="identification" class="form-label fw-semibold text-muted small">Buscar por Cédula del Cliente:</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="bi bi-search"></i></span>
                    <input type="text" id="identification" name="identification" value="@currentId" class="form-control border-start-0 rounded-end-3 shadow-sm" placeholder="Ej. 001-0000000-0" />
                </div>
            </div>
            <div class="col-md-3">
                <label for="status" class="form-label fw-semibold text-muted small">Filtrar por Estado:</label>
                <select id="status" name="status" class="form-select rounded-3 shadow-sm">
                    <option value="Activas" selected="@(currentStatus == "Activas")">Activas</option>
                    <option value="Canceladas" selected="@(currentStatus == "Canceladas")">Canceladas</option>
                    <option value="Todas" selected="@(currentStatus == "Todas")">Todas</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="type" class="form-label fw-semibold text-muted small">Filtrar por Tipo:</label>
                <select id="type" name="type" class="form-select rounded-3 shadow-sm">
                    <option value="Todas" selected="@(currentType == "Todas")">Todas</option>
                    <option value="Principal" selected="@(currentType == "Principal")">Principal</option>
                    <option value="Secundaria" selected="@(currentType == "Secundaria")">Secundaria</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100 rounded-3 shadow-sm fw-semibold mt-4">
                    <i class="bi bi-filter me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>

    <!-- Tabla de Cuentas -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">No. Cuenta</th>
                        <th>Cliente</th>
                        <th>Balance</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data != null && Model.Data.Any())
                    {
                        foreach (var acc in Model.Data)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark font-monospace">@acc.AccountNumber</td>
                                <td>@acc.ClientFullName</td>
                                <td class="fw-semibold text-success">RD$@acc.Balance.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-@(acc.Type == "Principal" ? "primary" : "info text-dark") px-3 py-2 rounded-pill">
                                        @acc.Type
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@(acc.Status == "Activa" ? "success" : "secondary") px-3 py-2 rounded-pill">
                                        @acc.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-accountNumber="@acc.AccountNumber" class="btn btn-sm btn-outline-info rounded-start-3" title="Ver transacciones">
                                            <i class="bi bi-eye"></i> Detalles
                                        </a>
                                        @if (acc.Type == "Secundaria" && acc.Status == "Activa")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-end-3"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#cancelAccountModal"
                                                    data-accountnumber="@acc.AccountNumber"
                                                    title="Cancelar cuenta">
                                                Cancelar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No se encontraron cuentas de ahorro registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Cancelación -->
<div class="modal fade" id="cancelAccountModal" tabindex="-1" aria-labelledby="cancelAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="cancelAccountModalLabel">Cancelar Cuenta de Ahorro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p id="cancelAccountModalMessage" class="fs-6 text-muted mb-0">¿Está seguro que desea cancelar esta cuenta?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                <form id="cancelAccountForm" asp-action="Cancel" method="post" class="d-inline">
                    <input type="hidden" id="modalAccountNumber" name="accountNumber" />
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold shadow-sm">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cancelAccountModal = document.getElementById('cancelAccountModal');
        cancelAccountModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var accountNumber = button.getAttribute('data-accountnumber');

            document.getElementById('modalAccountNumber').value = accountNumber;
            document.getElementById('cancelAccountModalMessage').textContent = "¿Está seguro que desea cancelar la cuenta " + accountNumber + "?";
        });
    </script>
}
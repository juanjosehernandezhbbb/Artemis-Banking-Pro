@model ArtemisBankingPro.Core.Application.Users.CreateUser.CreateUserCommand

@{
    ViewData["Title"] = "Crear Usuario";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <div class="mb-4">
            <h2 class="fw-bold text-dark">Registrar Nuevo Usuario</h2>
            <p class="text-muted">Complete los datos para dar de alta un usuario en el sistema. Quedará inactivo hasta su activación por correo.</p>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="FirstName" class="form-control rounded-3 shadow-sm" placeholder="Ej. Juan" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                    <input asp-for="LastName" class="form-control rounded-3 shadow-sm" placeholder="Ej. Pérez" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Identification" class="form-label fw-semibold">Cédula</label>
                    <input asp-for="Identification" class="form-control rounded-3 shadow-sm" placeholder="000-0000000-0" />
                    <span asp-validation-for="Identification" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3 shadow-sm" placeholder="correo@domain.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-semibold">Nombre de Usuario</label>
                    <input asp-for="UserName" class="form-control rounded-3 shadow-sm" placeholder="jperez" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label fw-semibold">Tipo de Usuario</label>
                    <select asp-for="Role" id="userRoleSelect" class="form-select rounded-3 shadow-sm" onchange="toggleInitialAmount()">
                        <option value="">Seleccione un rol...</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Cajero">Cajero</option>
                        <option value="Cliente">Cliente</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar Contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- Campo dinámico para Monto Inicial (Solo clientes) -->
                <div class="col-12" id="initialAmountContainer" style="display: none;">
                    <label asp-for="InitialAmount" class="form-label fw-semibold">Monto Inicial (Cuenta de Ahorro Principal)</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3">RD$</span>
                        <input asp-for="InitialAmount" type="number" step="0.01" class="form-control rounded-end-3 shadow-sm" value="0.00" />
                    </div>
                    <small class="text-muted">Si se deja en 0, se iniciará con RD$0.00 y se creará su cuenta principal automática.</small>
                    <span asp-validation-for="InitialAmount" class="text-danger small d-block"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">Cancelar</a>
                <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold shadow-sm">Guardar Usuario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleInitialAmount() {
            var roleSelect = document.getElementById("userRoleSelect");
            var container = document.getElementById("initialAmountContainer");
            if (roleSelect.value === "Cliente") {
                container.style.display = "block";
            } else {
                container.style.display = "none";
            }
        }
        document.addEventListener("DOMContentLoaded", function() {
            toggleInitialAmount();
        });
    </script>
}
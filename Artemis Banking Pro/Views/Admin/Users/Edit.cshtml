@model ArtemisBankingPro.Core.Application.Users.UpdateUser.UpdateUserCommand

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "_Layout";
    string userRole = ViewBag.UserRole as string ?? "";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <div class="mb-4">
            <h2 class="fw-bold text-dark">Editar Usuario</h2>
            <p class="text-muted">Modifique los datos permitidos del usuario. Deje la contraseña en blanco si no desea cambiarla.</p>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PerformedByUserId" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger rounded-3 mb-4"></div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="FirstName" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                    <input asp-for="LastName" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Identification" class="form-label fw-semibold">Cédula</label>
                    <input asp-for="Identification" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="Identification" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-semibold">Nombre de Usuario</label>
                    <input asp-for="UserName" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">Tipo de Usuario (No modificable)</label>
                    <input type="text" class="form-control rounded-3 shadow-sm bg-light" value="@userRole" readonly disabled />
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold">Nueva Contraseña (Opcional)</label>
                    <input asp-for="Password" type="password" class="form-control rounded-3 shadow-sm" placeholder="Dejar en blanco para mantener" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">Cancelar</a>
                <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold shadow-sm">Actualizar Usuario</button>
            </div>
        </form>
    </div>
</div>
@model ArtemisBankingPro.Core.Domain.Entities.CuentaAhorro

@{
    ViewData["Title"] = "Detalles de Cuenta";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Transacciones de Cuenta</h1>
            <p class="text-muted mb-0">Historial de movimientos registrados para la cuenta.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver atrás
        </a>
    </div>

    <!-- Info General -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 bg-white">
        <div class="row g-3">
            <div class="col-md-3">
                <small class="text-muted text-uppercase fw-semibold">No. Cuenta</small>
                <h5 class="fw-bold text-dark mb-0 font-monospace">@Model.NumeroCuenta</h5>
            </div>
            <div class="col-md-3">
                <small class="text-muted text-uppercase fw-semibold">Cliente</small>
                <h5 class="fw-bold text-dark mb-0">@(Model.Cliente?.Nombre) @(Model.Cliente?.Apellido)</h5>
            </div>
            <div class="col-md-2">
                <small class="text-muted text-uppercase fw-semibold">Balance Disponible</small>
                <h5 class="fw-bold text-success mb-0">RD$@Model.Balance.ToString("N2")</h5>
            </div>
            <div class="col-md-2">
                <small class="text-muted text-uppercase fw-semibold">Tipo</small>
                <h5 class="fw-bold text-dark mb-0">@Model.TipoCuenta</h5>
            </div>
            <div class="col-md-2">
                <small class="text-muted text-uppercase fw-semibold">Estado</small>
                <h5 class="fw-bold text-dark mb-0">@Model.Estado</h5>
            </div>
        </div>
    </div>

    <!-- Listado de Transacciones -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Monto</th>
                        <th>Tipo</th>
                        <th>Destino</th>
                        <th>Origen</th>
                        <th class="text-end pe-4">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transacciones != null && Model.Transacciones.Any())
                    {
                        foreach (var tx in Model.Transacciones.OrderByDescending(t => t.Fecha))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@tx.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">RD$@tx.Monto.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-@(tx.Tipo == ArtemisBankingPro.Core.Domain.Enums.TipoTransaccion.Credito ? "success" : "danger") px-3 py-2 rounded-pill">
                                        @tx.Tipo
                                    </span>
                                </td>
                                <td>@tx.Destino</td>
                                <td>@tx.Origen</td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-@(tx.Estado == ArtemisBankingPro.Core.Domain.Enums.EstadoTransaccion.Aprobada ? "success" : "secondary") px-3 py-2 rounded-pill">
                                        @tx.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No se registran transacciones para esta cuenta.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
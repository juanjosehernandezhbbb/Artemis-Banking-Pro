@model ArtemisBankingPro.Core.Application.CreditCards.CreateCreditCard.CreateCreditCardCommand

@{
    ViewData["Title"] = "Asignar Tarjeta de Crédito";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <div class="mb-4">
            <h2 class="fw-bold text-dark">Asignar Tarjeta - Paso 2</h2>
            <p class="text-muted">Configure el límite de crédito aprobado para la nueva tarjeta.</p>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ClientId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

            <div class="mb-4">
                <label asp-for="CreditLimit" class="form-label fw-semibold">Límite de Crédito</label>
                <div class="input-group">
                    <span class="input-group-text rounded-start-3">RD$</span>
                    <input asp-for="CreditLimit" type="number" step="0.01" class="form-control rounded-end-3 shadow-sm" placeholder="0.00" />
                </div>
                <span asp-validation-for="CreditLimit" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="SelectClient" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">Volver atrás</a>
                <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold shadow-sm">Asignar</button>
            </div>
        </form>
    </div>
</div>
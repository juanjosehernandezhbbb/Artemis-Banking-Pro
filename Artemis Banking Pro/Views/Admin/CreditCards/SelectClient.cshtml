@model IEnumerable<ArtemisBankingPro.Core.Application.Common.Models.UserDto>

@{
    ViewData["Title"] = "Seleccionar Cliente para Tarjeta";
    Layout = "_Layout";
    decimal avgDebt = ViewBag.AverageSystemDebt ?? 0m;
    string searchId = ViewBag.SearchIdentification ?? "";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Asignar Tarjeta - Paso 1: Seleccionar Cliente</h2>
            <p class="text-muted">Elija un cliente activo del sistema.</p>
        </div>
        <div class="card bg-primary text-white border-0 shadow-sm rounded-4 px-3 py-2">
            <small class="text-white-50">Deuda Promedio del Sistema:</small>
            <span class="fw-bold fs-5">RD$@avgDebt.ToString("N2")</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <form method="get" asp-action="SelectClient" class="row g-3 align-items-center">
            <div class="col-md-9">
                <input type="text" name="identification" value="@searchId" class="form-control rounded-3 shadow-sm" placeholder="Filtrar por cédula (Ej. 001-0000000-0)" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100 rounded-3 shadow-sm fw-semibold">Buscar</button>
            </div>
        </form>
    </div>

    <form asp-action="PostSelectClient" method="post">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="ps-4" style="width: 50px;">Select</th>
                            <th>Cédula</th>
                            <th>Nombre Completo</th>
                            <th>Correo Electrónico</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var client in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <input class="form-check-input" type="radio" name="clientId" value="@client.Id" required />
                                    </td>
                                    <td class="fw-semibold text-dark">@client.Identification</td>
                                    <td>@client.FirstName @client.LastName</td>
                                    <td>@client.Email</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No se encontraron clientes activos.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">Volver atrás</a>
            <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold shadow-sm">Siguiente paso</button>
        </div>
    </form>
</div>
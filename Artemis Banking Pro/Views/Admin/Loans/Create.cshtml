@model ArtemisBankingPro.Core.Application.Loans.CreateLoan.CreateLoanCommand

@{
    ViewData["Title"] = "Configurar Préstamo";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <div class="mb-4">
            <h2 class="fw-bold text-dark">Asignar Préstamo - Paso 2</h2>
            <p class="text-muted">Configure el capital, plazo y tasa de interés anual.</p>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ClientId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

            <div class="mb-3">
                <label asp-for="CapitalAmount" class="form-label fw-semibold">Monto a Prestar (Capital)</label>
                <div class="input-group">
                    <span class="input-group-text rounded-start-3">RD$</span>
                    <input asp-for="CapitalAmount" type="number" step="0.01" class="form-control rounded-end-3 shadow-sm" placeholder="0.00" />
                </div>
                <span asp-validation-for="CapitalAmount" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TermInMonths" class="form-label fw-semibold">Plazo del Préstamo (Meses)</label>
                <select asp-for="TermInMonths" class="form-select rounded-3 shadow-sm">
                    @for (int i = 6; i <= 60; i += 6)
                    {
                        <option value="@i">@i meses</option>
                    }
                </select>
                <span asp-validation-for="TermInMonths" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="AnnualInterestRate" class="form-label fw-semibold">Tasa de Interés Anual (%)</label>
                <input asp-for="AnnualInterestRate" type="number" step="0.01" class="form-control rounded-3 shadow-sm" placeholder="Ej. 12.5" />
                <span asp-validation-for="AnnualInterestRate" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="SelectClient" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">Volver atrás</a>
                <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold shadow-sm">Asignar préstamo</button>
            </div>
        </form>
    </div>
</div>
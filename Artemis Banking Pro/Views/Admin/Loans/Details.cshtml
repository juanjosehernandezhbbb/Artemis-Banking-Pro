@model ArtemisBankingPro.Core.Application.Loans.GetLoanById.LoanDetailDto

@{
    ViewData["Title"] = "Detalles de Préstamo";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Tabla de Amortización</h1>
            <p class="text-muted mb-0">Detalles del préstamo y desglose de cuotas (Sistema Francés).</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver atrás
        </a>
    </div>

    <!-- Info General del Préstamo -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 bg-white">
        <div class="row g-3">
            <div class="col-md-3">
                <small class="text-muted text-uppercase fw-semibold">Número de Préstamo</small>
                <h5 class="fw-bold text-dark mb-0">@Model.LoanNumber</h5>
            </div>
            <div class="col-md-3">
                <small class="text-muted text-uppercase fw-semibold">Cliente</small>
                <h5 class="fw-bold text-dark mb-0">@Model.ClientFullName</h5>
            </div>
            <div class="col-md-2">
                <small class="text-muted text-uppercase fw-semibold">Capital Aprobado</small>
                <h5 class="fw-bold text-primary mb-0">RD$@Model.CapitalAmount.ToString("N2")</h5>
            </div>
            <div class="col-md-2">
                <small class="text-muted text-uppercase fw-semibold">Tasa Anual</small>
                <h5 class="fw-bold text-dark mb-0">@Model.AnnualInterestRate%</h5>
            </div>
            <div class="col-md-2">
                <small class="text-muted text-uppercase fw-semibold">Plazo / Estado</small>
                <h5 class="fw-bold text-dark mb-0">@Model.TermInMonths meses (@Model.Status)</h5>
            </div>
        </div>
    </div>

    <!-- Tabla de Cuotas -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">No. Cuota</th>
                        <th>Fecha Vencimiento</th>
                        <th>Valor Cuota</th>
                        <th>Interés</th>
                        <th>Capital</th>
                        <th>Saldo Pendiente</th>
                        <th>Estado de Pago</th>
                        <th class="text-end pe-4">Atraso</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Amortization != null && Model.Amortization.Any())
                    {
                        foreach (var inst in Model.Amortization)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@inst.InstallmentNumber</td>
                                <td>@inst.DueDate.ToString("dd/MM/yyyy")</td>
                                <td>RD$@inst.InstallmentAmount.ToString("N2")</td>
                                <td>RD$@inst.InterestAmount.ToString("N2")</td>
                                <td>RD$@inst.CapitalAmount.ToString("N2")</td>
                                <td class="fw-semibold">RD$@inst.PendingInstallmentAmount.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-@(inst.PaymentStatus == "Pagada" ? "success" : inst.PaymentStatus == "Parcialmente pagada" ? "warning text-dark" : "secondary") px-3 py-2 rounded-pill">
                                        @inst.PaymentStatus
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    @if (inst.IsLate)
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">Atrasada</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Al día</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No hay cuotas generadas para este préstamo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Pago a Tarjeta de Crédito";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h2 class="h4 fw-bold text-dark mb-3">Pago a Tarjeta de Crédito</h2>
                <p class="text-muted mb-4">Alique un pago a una tarjeta activa utilizando fondos de una cuenta de ahorro.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3">
                        <div asp-validation-summary="All" class="mb-0 text-danger small"></div>
                    </div>
                }

                <form asp-action="PayCreditCard" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="sourceAccountNumber" class="form-label fw-semibold">Número de cuenta origen</label>
                        <input type="text" name="sourceAccountNumber" id="sourceAccountNumber" class="form-control rounded-3" placeholder="Ej. 12345678" required />
                    </div>

                    <div class="mb-3">
                        <label for="cardNumber" class="form-label fw-semibold">Número de tarjeta de crédito (16 dígitos)</label>
                        <input type="text" name="cardNumber" id="cardNumber" maxlength="16" class="form-control rounded-3" placeholder="#### #### #### ####" required />
                    </div>

                    <div class="mb-4">
                        <label for="monto" class="form-label fw-semibold">Monto a pagar</label>
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input type="number" step="0.01" min="0.01" name="monto" id="monto" class="form-control rounded-end-3" placeholder="0.00" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold shadow-sm">Realizar pago</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
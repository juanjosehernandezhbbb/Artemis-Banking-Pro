@{
    ViewData["Title"] = "Confirmar Retiro";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <h2 class="h4 fw-bold text-dark mb-3">Confirmación de Retiro</h2>
                <p class="fs-6 text-muted mb-4">¿Está seguro que desea realizar este retiro?</p>

                <ul class="list-group list-group-flush text-start mb-4">
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="fw-semibold text-muted">Titular de la cuenta:</span>
                        <span class="fw-bold text-dark">@ViewBag.Titular</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="fw-semibold text-muted">Número de cuenta origen:</span>
                        <span class="fw-bold text-dark font-monospace">@ViewBag.NumeroCuenta</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="fw-semibold text-muted">Monto a retirar:</span>
                        <span class="fw-bold text-danger fs-5">RD$@(((decimal)ViewBag.Monto).ToString("N2"))</span>
                    </li>
                </ul>

                <form asp-action="ExecuteWithdrawal" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@ViewBag.AccountId" />
                    <input type="hidden" name="monto" value="@ViewBag.Monto" />

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Withdrawal" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold shadow-sm">Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
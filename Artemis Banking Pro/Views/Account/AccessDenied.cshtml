@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout";
}

<div class="container py-5 text-center" style="min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white" style="max-width: 500px; width: 100%;">
        <div class="mb-4">
            <i class="bi bi-shield-exclamation text-danger display-1"></i>
        </div>
        <h1 class="fw-bold text-dark mb-2">403</h1>
        <h3 class="h5 fw-semibold text-secondary mb-4">No posee permisos para acceder a esta sección.</h3>
        <p class="text-muted small mb-4">Si considera que esto es un error, por favor comuníquese con el administrador del sistema.</p>
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary py-2 rounded-3 fw-bold shadow-sm">
            <i class="bi bi-house-door me-1"></i> Regresar al inicio
        </a>
    </div>
</div>
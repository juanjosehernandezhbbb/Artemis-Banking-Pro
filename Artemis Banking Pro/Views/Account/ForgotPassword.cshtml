@model Artemis_Banking_Pro.Models.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña - Artemis Banking Pro</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f4f6f9;
        }

        .login-image-bg {
            background-image: url('/images/bg-login.png');
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .login-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(13, 110, 253, 0.82) 0%, rgba(0, 67, 168, 0.92) 100%);
        }

        .z-index-1 {
            z-index: 1;
            position: relative;
        }

        .form-control-custom {
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            font-size: 1.05rem;
            transition: all 0.3s;
        }

            .form-control-custom:focus {
                background-color: #ffffff;
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-4 p-md-5">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden w-100" style="max-width: 1350px;">
        <div class="row g-0">

            <!-- Panel Izquierdo -->
            <div class="col-lg-6 d-none d-lg-flex login-image-bg flex-column justify-content-between p-5 p-lg-5 text-white" style="min-height: 650px;">
                <div class="login-overlay"></div>

                <div class="z-index-1 mt-4 px-3">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock display-3"></i>
                    </div>
                    <h1 class="display-4 fw-bold mb-4">Recuperación <br /> de Acceso</h1>
                    <p class="fs-5 fw-light opacity-75" style="line-height: 1.6; max-width: 480px;">
                        Ingrese su usuario registrado para iniciar el proceso seguro de restablecimiento de contraseña en Artemis Banking Pro.
                    </p>
                </div>

                <div class="z-index-1 d-flex align-items-center gap-4 opacity-75 mb-4 px-3 fs-6">
                    <span><i class="bi bi-shield-check me-1"></i> Protocolo Seguro</span>
                    <span><i class="bi bi-key me-1"></i> Verificación Rápida</span>
                </div>
            </div>

            <!-- Panel Derecho - Formulario -->
            <div class="col-lg-6 d-flex align-items-center justify-content-center bg-white p-5 p-lg-5" style="min-height: 650px;">
                <div class="w-100" style="max-width: 480px;">

                    <div class="text-center mb-5">
                        <i class="bi bi-shield-lock text-primary fs-1 d-lg-none mb-3"></i>
                        <h2 class="fw-bold text-dark mb-2 fs-2">Recuperar Acceso</h2>
                        <p class="text-muted">Ingrese su nombre de usuario para solicitar el restablecimiento.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm p-3 mb-4">
                            <div asp-validation-summary="All" class="text-danger mb-0 small fw-bold"></div>
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="UserName" class="form-label fw-bold text-secondary small text-uppercase mb-2">Nombre de usuario</label>
                            <input asp-for="UserName" class="form-control form-control-custom" placeholder="Ingrese su usuario" autocomplete="off" autofocus />
                            <span asp-validation-for="UserName" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>

                        <div class="d-grid mt-5 mb-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm rounded-3 py-3 fs-5">
                                Enviar solicitud
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <a href="@Url.Action("Login", "Account")" class="text-decoration-none text-muted small fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i> Volver al Login
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
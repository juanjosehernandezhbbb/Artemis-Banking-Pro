@model Artemis_Banking_Pro.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4" style="width: 100%; max-width: 420px;">
        <div class="card-header bg-primary text-white text-center py-4 border-0 rounded-top-4">
            <h3 class="mb-0 fw-bold">Recuperar Acceso</h3>
        </div>
        <div class="card-body p-4 p-md-5 bg-white">
            <p class="text-muted text-center mb-4">Ingrese su nombre de usuario para solicitar el restablecimiento de su contraseña.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-3 shadow-sm p-3 mb-4">
                    <div asp-validation-summary="All" class="text-danger mb-0 small fw-bold"></div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label asp-for="UserName" class="form-label fw-bold text-secondary">Nombre de usuario</label>
                    <input asp-for="UserName" class="form-control form-control-lg rounded-3 bg-light border-0" placeholder="Ingrese su usuario" autocomplete="off" />
                    <span asp-validation-for="UserName" class="text-danger small fw-semibold"></span>
                </div>
                <div class="d-grid gap-2 mt-5 mb-2">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm rounded-3">Enviar solicitud</button>
                </div>
            </form>
        </div>
        <div class="card-footer text-center py-4 bg-light border-0 rounded-bottom-4">
            <a href="@Url.Action("Login", "Account")" class="text-decoration-none text-secondary fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Volver al Login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
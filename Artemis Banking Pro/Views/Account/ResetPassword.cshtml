@model Artemis_Banking_Pro.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Crear nueva contraseña";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4" style="width: 100%; max-width: 420px;">
        <div class="card-header bg-primary text-white text-center py-4 border-0 rounded-top-4">
            <h3 class="mb-0 fw-bold">Nueva Contraseña</h3>
        </div>
        <div class="card-body p-4 p-md-5 bg-white">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-3 shadow-sm p-3 mb-4">
                    <div asp-validation-summary="All" class="text-danger mb-0 small fw-bold"></div>
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-bold text-secondary">Nueva contraseña</label>
                    <input asp-for="Password" class="form-control form-control-lg rounded-3 bg-light border-0" placeholder="Ingrese nueva contraseña" />
                    <span asp-validation-for="Password" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold text-secondary">Confirmar contraseña</label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg rounded-3 bg-light border-0" placeholder="Confirme la contraseña" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small fw-semibold"></span>
                </div>

                <div class="d-grid gap-2 mt-5 mb-2">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm rounded-3">Restablecer contraseña</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
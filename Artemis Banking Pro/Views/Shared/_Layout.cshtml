<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Artemis_Banking_Pro.styles.css" asp-append-version="true" />
    <style>
        .nav-pills .nav-link.active {
            transition: all 0.3s ease;
        }

        .nav-pills .nav-link:hover:not(.active) {
            background-color: #e9ecef !important;
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-4 py-3">
                <div class="container-fluid px-4">
                    <!-- El logo redirige al Admin Home si es administrador, o al Home general -->
                    <a class="navbar-brand fw-bold text-primary fs-4" asp-area="" asp-controller="@(User.IsInRole("Administrador") ? "Admin" : "Home")" asp-action="Index">
                        <i class="bi bi-bank2 me-2"></i> Artemis Banking
                    </a>

                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                        <ul class="navbar-nav align-items-center gap-3">
                            <li class="nav-item text-secondary fw-semibold">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger fw-bold px-4 rounded-pill shadow-sm" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Menú de navegación secundario persistente para Administradores -->
            @if (User.IsInRole("Administrador"))
            {
                string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                <div class="container-fluid px-4 mb-4">
                    <div class="card shadow-sm border-0 rounded-4 bg-white p-2">
                        <nav class="nav nav-pills flex-column flex-sm-row justify-content-around gap-2">
                            <a class="flex-sm-fill text-sm-center nav-link @(currentController == "Admin" && currentAction == "Index" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" href="@Url.Action("Index", "Admin")">
                                <i class="bi bi-house-door-fill me-1"></i> Home
                            </a>
                            <a class="flex-sm-fill text-sm-center nav-link @(currentController == "Users" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" href="@Url.Action("Index", "Users")">
                                <i class="bi bi-people-fill me-1"></i> Gestión de usuarios
                            </a>
                            <a class="flex-sm-fill text-sm-center nav-link @(currentController == "Loan" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" href="@Url.Action("Index", "Loan")">
                                <i class="bi bi-cash-stack me-1"></i> Gestión de préstamos
                            </a>
                            <a class="flex-sm-fill text-sm-center nav-link @(currentController == "CreditCard" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" href="@Url.Action("Index", "CreditCard")">
                                <i class="bi bi-credit-card-fill me-1"></i> Gestión de tarjetas
                            </a>
                            <a class="flex-sm-fill text-sm-center nav-link @(currentController == "SavingsAccount" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" href="@Url.Action("Index", "SavingsAccount")">
                                <i class="bi bi-piggy-bank-fill me-1"></i> Gestión de cuentas
                            </a>
                        </nav>
                    </div>
                </div>
            }

            <!-- NUEVO: Menú de navegación secundario persistente para Clientes -->
            @if (User.IsInRole("Cliente"))
            {
                string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                <div class="container-fluid px-4 mb-4">
                    <div class="card shadow-sm border-0 rounded-4 bg-white p-2">
                        <ul class="nav nav-pills flex-column flex-sm-row justify-content-around gap-2 m-0 ps-0">
                            <li class="nav-item flex-sm-fill text-sm-center list-unstyled">
                                <a class="nav-link @(currentAction == "Index" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" asp-controller="Client" asp-action="Index">
                                    <i class="bi bi-house-door-fill me-1"></i> Home
                                </a>
                            </li>
                            <li class="nav-item dropdown flex-sm-fill text-sm-center list-unstyled">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold bg-light rounded-3 py-2" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                                    <i class="bi bi-arrow-left-right me-1"></i> Transacciones
                                </a>
                                <ul class="dropdown-menu border-0 shadow mt-2 rounded-4">
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Client" asp-action="ExpressTransaction"><i class="bi bi-lightning-charge me-2 text-warning"></i> Express</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Client" asp-action="PayCreditCard"><i class="bi bi-credit-card me-2 text-primary"></i> Pago Tarjeta</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Client" asp-action="PayLoan"><i class="bi bi-cash-stack me-2 text-success"></i> Pago Préstamo</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Client" asp-action="BeneficiaryTransaction"><i class="bi bi-person-lines-fill me-2 text-info"></i> A Beneficiarios</a></li>
                                </ul>
                            </li>
                            <li class="nav-item flex-sm-fill text-sm-center list-unstyled">
                                <a class="nav-link @(currentAction == "Beneficiaries" || currentAction == "AddBeneficiary" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" asp-controller="Client" asp-action="Beneficiaries">
                                    <i class="bi bi-people-fill me-1"></i> Beneficiarios
                                </a>
                            </li>
                            <li class="nav-item flex-sm-fill text-sm-center list-unstyled">
                                <a class="nav-link @(currentAction == "CashAdvance" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" asp-controller="Client" asp-action="CashAdvance">
                                    <i class="bi bi-cash-coin me-1"></i> Avance de Efectivo
                                </a>
                            </li>
                            <li class="nav-item flex-sm-fill text-sm-center list-unstyled">
                                <a class="nav-link @(currentAction == "Transfer" ? "active fw-bold shadow-sm" : "text-dark fw-semibold bg-light") rounded-3 py-2" asp-controller="Client" asp-action="Transfer">
                                    <i class="bi bi-arrow-repeat me-1"></i> Transferencia
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </header>
    }

    <div class="container-fluid px-4 flex-grow-1 pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- El footer fue eliminado para un diseño más limpio -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>